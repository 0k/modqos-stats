#!/bin/bash
##
## Release asset: the static musl ``modqos-stats`` binary, attached to
## the GitHub release by 0k-pkg's ``github-release`` post-publish hook.
##
## Usage: musl-binary OUTPUT_DIR   (``$VERSION`` set by the hook)
##

set -eu

out=${1:?usage: musl-binary OUTPUT_DIR}
: "${VERSION:?VERSION must be set by the github-release hook}"

tmpdir=$(mktemp -d)
trap 'rm -rf -- "$tmpdir"' EXIT
trap 'exit 1' HUP INT TERM

## ``bin/build`` prints only the artifact path on stdout, once it has
## checked that the binary is static and reports the crate version.
binary=$(bin/build --out-dir "$tmpdir")
[ -f "$binary" ] || {
    echo "Error: musl binary not found at $binary" >&2
    exit 1
}

cp "$binary" "$out/modqos-stats-${VERSION}-x86_64-linux-musl"
